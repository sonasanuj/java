#include <stdio.h>
struct poly
{
    int coeff;
    int exp;
};
struct poly P1[20], P2[20], P3[40];
int t1, t2, t3;
/* Function to read a polynomial */
void readPolynomial(struct poly P[], int *t)
{
    int i;
    printf("Enter the number of terms: ");
    scanf("%d", t);
    printf("Enter the coefficient and exponent in descending order of exponents:\n");
    for(i = 0; i < *t; i++)
    {
        printf("Term %d\n", i + 1);
        printf("Coefficient: ");
        scanf("%d", &P[i].coeff);
        printf("Exponent: ");
        scanf("%d", &P[i].exp);
    }
}
/* Function to add two polynomials */
void addPolynomial(struct poly P1[], int t1,
                   struct poly P2[], int t2,
                   struct poly P3[], int *t3)
{
    int i = 0, j = 0, k = 0;
    while(i < t1 && j < t2)
    {
        if(P1[i].exp == P2[j].exp)
        {
            P3[k].coeff = P1[i].coeff + P2[j].coeff;
            P3[k].exp = P1[i].exp;
            i++;
            j++;
            k++;
        }
        else if(P1[i].exp > P2[j].exp)
        {
            P3[k] = P1[i];
            i++;
            k++;
        }
        else
        {
            P3[k] = P2[j];
            j++;
            k++;
        }
    }
    while(i < t1)
    {
        P3[k] = P1[i];
        i++;
        k++;
    }
    while(j < t2)
    {
        P3[k] = P2[j];
        j++;
        k++;
    }
    *t3 = k;
}
/* Function to display a polynomial */
void displayPolynomial(struct poly P[], int t)
{
    int i;
    if(t == 0)
    {
        printf("Polynomial is empty.\n");
        return;
    }
    for(i = 0; i < t; i++)
    {
        printf("%dx^%d", P[i].coeff, P[i].exp);
        if(i != t - 1)
            printf(" + ");
    }
    printf("\n");
}
/* Main Function */
int main()
{
    int choice;
    do
    {
        printf("\n********** MENU **********\n");
        printf("1. Add Two Polynomials\n");
        printf("2. Display Resultant Polynomial\n");
        printf("3. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);
        switch(choice)
        {
            case 1:
                printf("\nEnter First Polynomial\n");
                readPolynomial(P1, &t1);
                printf("\nEnter Second Polynomial\n");
                readPolynomial(P2, &t2);
                addPolynomial(P1, t1, P2, t2, P3, &t3);
                printf("\nPolynomial Added Successfully.\n");
                break;
            case 2:
                printf("\nResultant Polynomial:\n");
                displayPolynomial(P3, t3);
                break;
            case 3:
                printf("\nProgram Terminated.\n");
                break;
            default:
                printf("\nInvalid Choice!\n");
        }
    } while(choice != 3);
    return 0;
}
