#include <stdio.h>
int T1[100][3], T2[100][3], SUM[200][3], TRANS[200][3];
/* Function to read sparse matrix in triplet form */
void readTriplet(int T[][3])
{
    int i, terms;
    printf("Enter number of rows, columns and non-zero elements: ");
    scanf("%d%d%d", &T[0][0], &T[0][1], &T[0][2]);
    terms = T[0][2];
    printf("Enter the triplet elements (Row Column Value):\n");
    for(i = 1; i <= terms; i++)
    {
        scanf("%d%d%d", &T[i][0], &T[i][1], &T[i][2]);
    }
}
/* Function to add two triplet matrices */
void addTriplet(int T1[][3], int T2[][3], int SUM[][3])
{
    int i = 1, j = 1, k = 1;
    int value;
    if(T1[0][0] != T2[0][0] || T1[0][1] != T2[0][1])
    {
        printf("\nAddition Not Possible\n");
        return;
    }
    while(i <= T1[0][2] && j <= T2[0][2])
    {
        if(T1[i][0] == T2[j][0] &&
           T1[i][1] == T2[j][1])
        {
            value = T1[i][2] + T2[j][2];
            if(value != 0)
            {
                SUM[k][0] = T1[i][0];
                SUM[k][1] = T1[i][1];
                SUM[k][2] = value;
                k++;
            }
            i++;
            j++;
        }
        else if(T1[i][0] < T2[j][0] ||
               (T1[i][0] == T2[j][0] &&
                T1[i][1] < T2[j][1]))
        {
            SUM[k][0] = T1[i][0];
            SUM[k][1] = T1[i][1];
            SUM[k][2] = T1[i][2];
            i++;
            k++;
        }
        else
        {
            SUM[k][0] = T2[j][0];
            SUM[k][1] = T2[j][1];
            SUM[k][2] = T2[j][2];
            j++;
            k++;
        }
    }
    while(i <= T1[0][2])
    {
        SUM[k][0] = T1[i][0];
        SUM[k][1] = T1[i][1];
        SUM[k][2] = T1[i][2];
        i++;
        k++;
    }
    while(j <= T2[0][2])
    {
        SUM[k][0] = T2[j][0];
        SUM[k][1] = T2[j][1];
        SUM[k][2] = T2[j][2];
        j++;
        k++;
    }
    SUM[0][0] = T1[0][0];
    SUM[0][1] = T1[0][1];
    SUM[0][2] = k - 1;
}
/* Function to transpose the resultant triplet matrix */
void transposeTriplet(int SUM[][3], int TRANS[][3])
{
    int i, col, k = 1;
    TRANS[0][0] = SUM[0][1];
    TRANS[0][1] = SUM[0][0];
    TRANS[0][2] = SUM[0][2];
    for(col = 0; col < SUM[0][1]; col++)
    {
        for(i = 1; i <= SUM[0][2]; i++)
        {
            if(SUM[i][1] == col)
            {
                TRANS[k][0] = SUM[i][1];
                TRANS[k][1] = SUM[i][0];
                TRANS[k][2] = SUM[i][2];
                k++;
            }
        }
    }
}
void displayTriplet(int T[][3])
{
    int i;
    printf("\nRow\tColumn\tValue\n");
    for(i = 0; i <= T[0][2]; i++)
    {
        printf("%d\t%d\t%d\n", T[i][0], T[i][1], T[i][2]);
    }
}
int main()
{
    int choice;
    do
    {
        printf("\n********** MENU **********\n");
        printf("1. Add Two Sparse Matrices\n");
        printf("2. Display Transpose of Resultant Matrix\n");
        printf("3. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);
        switch(choice)
        {
            case 1:
                printf("\nEnter First Sparse Matrix in Triplet Form\n");
                readTriplet(T1);
                printf("\nEnter Second Sparse Matrix in Triplet Form\n");
                readTriplet(T2);
                addTriplet(T1, T2, SUM);
                printf("\nResultant Triplet Matrix\n");
                displayTriplet(SUM);
                break;
            case 2:
                if(SUM[0][2] == 0)
                    printf("\nFirst perform Addition (Choice 1).\n");
                else
                {
                }
                    transposeTriplet(SUM, TRANS);
                    printf("\nTranspose of Resultant Triplet Matrix\n");
                    displayTriplet(TRANS);
                break;
            case 3:
                printf("\nProgram Terminated.\n");
                break;
            default:
                printf("\nInvalid Choice!\n");
        }
    } while(choice != 3);
    return 0;
}
